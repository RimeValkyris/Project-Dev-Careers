# Security headers for Cloudflare Pages (Netlify reads this file too).
# The main Content-Security-Policy is a <meta> tag that Astro generates at build
# time (see astro.config.mjs). Browsers ignore a few directives in <meta>, so
# those are sent here as a header. Both policies apply together.

/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Hashed build assets never change, so browsers can cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Serve the brochure as a download, not inside the page.
/downloads/*
  Content-Disposition: attachment
  X-Robots-Tag: noindex
