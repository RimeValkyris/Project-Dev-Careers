---
import BaseHead from '../components/BaseHead.astro';
import BrochureButton from '../components/BrochureButton.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import KeynoteSpeakers from '../components/KeynoteSpeakers.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';





// Program of Activities. Times are 24-hour ("13:15"); they are shown as 12-hour on the page.
// kind: 'break' rows span the table (registration, lunch, closing); 'talk' rows are the main sessions.
// Leave `by` empty when the person responsible is not confirmed yet.
type ProgramItem = {
	start: string;
	end: string;
	title: string;
	details?: string;
	by?: string;
	kind?: 'break' | 'talk';
	note?: string;
};

const program: ProgramItem[] = [
	{ start: '07:30', end: '08:30', title: 'Registration', by: 'Registration Committee', kind: 'break' },
	{ start: '08:30', end: '08:45', title: 'Preliminaries', details: 'National Anthem, TSU Hymn, & Doxology', by: 'Program Committee' },
	{ start: '08:45', end: '09:00', title: 'Opening Remarks', details: 'Welcome address and overview of event rules', by: 'Dean Jerome Legaspi' },
	{ start: '09:00', end: '10:00', title: 'Emerging Technologies', details: 'Trends shaping tech (Web Development, DevOps, cloud, etc.) and what students should watch out for', kind: 'talk', note: 'Talk · Q&A · Awarding' },
	{ start: '10:00', end: '10:15', title: 'Raffle Entry and Social Media Engagement', details: 'Showcase requirements to join the raffle prizes (post pictures of the event and use the official hashtag)', by: 'Host' },
	{ start: '10:15', end: '11:15', title: 'Employability Tips and Jobs', details: 'How to become job-ready, in-demand roles, what employers look for', kind: 'talk', note: 'Talk · Q&A · Awarding' },
	{ start: '11:15', end: '11:30', title: 'Sponsor Segment', details: 'Acknowledgment of event co-sponsors & student councils', by: 'Sponsors' },
	{ start: '11:30', end: '12:00', title: 'Lightning Talks', details: 'Student/Faculty/Speaker 1-minute showcases', by: 'Host/Volunteers' },
	{ start: '12:00', end: '13:15', title: 'Lunch Break', by: 'All Participants', kind: 'break' },
	{ start: '13:15', end: '13:30', title: 'Post-Lunch Energizer / Kahoot', details: 'Interactive game with cash prizes', by: 'Program Committee' },
	{ start: '13:30', end: '15:00', title: 'Resume & Portfolio, and How to Market Yourself', details: 'Live resume/portfolio review, personal branding, and self-marketing tips', kind: 'talk', note: 'Talk · Q&A · Awarding' },
	{ start: '15:00', end: '15:30', title: 'Live Mock Interview', details: 'One or two volunteers play an applicant while the speaker takes the interviewer role', by: 'Host, Volunteers, and Speaker' },
	{ start: '15:30', end: '16:00', title: 'Keynote: Opportunities after Graduation', details: 'Showcase opportunities to speed up employability after graduation', by: 'Dr. Marlon V. Gamido', kind: 'talk' },
	{ start: '16:00', end: '16:30', title: 'Grand Raffle', details: 'Awarding of raffle prizes', by: 'Host' },
	{ start: '16:30', end: '16:40', title: 'Closing Remarks', details: 'Official closing remarks and formal wrap-up from the FTS Coordinator', by: 'Sir Lito Alexis M. Tolentino' },
	{ start: '16:40', end: '17:00', title: 'Closing, Attendance and Evaluation', by: 'Registration & Evaluation Committee', kind: 'break' },
];

const toMinutes = (time: string) => {
	const [hours, minutes] = time.split(':').map(Number);
	return hours * 60 + minutes;
};
const to12Hour = (time: string) => {
	const [hours, minutes] = time.split(':').map(Number);
	return `${((hours + 11) % 12) + 1}:${String(minutes).padStart(2, '0')} ${hours < 12 ? 'AM' : 'PM'}`;
};
const formatDuration = (minutes: number) =>
	minutes >= 60 ? `${Math.floor(minutes / 60)} hr${minutes % 60 ? ` ${minutes % 60} min` : ''}` : `${minutes} min`;

const schedule = program.map((item) => ({
	...item,
	startLabel: to12Hour(item.start),
	endLabel: to12Hour(item.end),
	duration: formatDuration(toMinutes(item.end) - toMinutes(item.start)),
}));
const dayStart = to12Hour(program[0].start);
const dayEnd = to12Hour(program[program.length - 1].end);
const programStart = to12Hour(program.find((item) => item.kind !== 'break')?.start ?? program[0].start);
const talkCount = program.filter((item) => item.kind === 'talk').length;
const focusAreas = program.filter((item) => item.kind === 'talk' && !item.title.startsWith('Keynote')).map((item) => item.title);
const lunch = program.find((item) => item.title === 'Lunch Break');

const faqs = [
	{ q: 'Who is Dev Pipeline 2026 for?', a: 'Anyone exploring software development, from first-time learners to working developers who want to keep growing.' },
	{ q: 'Do I need professional experience?', a: 'No. Sessions are designed to meet you at your current level and give you a useful next step.' },
	{ q: 'What should I bring?', a: 'Bring your questions, your current project if you have one, and a willingness to try something small.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content" class="home-main">
			<section class="portal-hero">
				<div class="section-container hero-container">
					<div class="hero-copy">
						<p class="hero-kicker">Presented by TWG Committee</p>
						<h1>BEYOND<br /><span>THE SOARING CAPS</span></h1>
						<p class="intro">Dev Pipeline 2026 connects curious learners, working developers, and mentors through practical seminars, honest conversations, and shared momentum.</p>
						<div class="hero-actions">
							<a class="button primary" href="#agenda">See the agenda</a>
							<BrochureButton variant="ghost" />
						</div>
					</div>

					<article class="event-card hero-card" id="event">
						<div class="event-card-banner">
							<span class="event-card-date"><strong>FRI</strong>{dayStart}</span>
							<span class="event-card-title">Dev Pipeline 2026</span>
						</div>
						<div class="event-card-body">
							<h3>From first commit to next opportunity</h3>
							<dl class="event-meta">
								<div><dt>When</dt><dd>Friday, {dayStart} to {dayEnd}</dd></div>
								<div><dt>Format</dt><dd>{talkCount} talks with Q&A</dd></div>
								<div><dt>For</dt><dd>Students and career changers</dd></div>
							</dl>
							<BrochureButton variant="outline" />
						</div>
					</article>
				</div>
			</section>

			<section id="programs" class="about-band">
				<div class="section-container">
					<div class="about-copy">
						<p class="about-kicker">About the event</p>
						<h2>What is <span>The Dev Pipeline?</span></h2>
						<p class="about-tagline">A college-wide webinar and career-immersion event for CCS students</p>
						<p class="about-body">"THE DEV PIPELINE 2026: Beyond the Soaring Caps," is a college-wide webinar and career-immersion event designed to give students of the <strong>College of Computer Studies (CCS)</strong> a practical, grounded look at where the technology industry is heading and what it genuinely takes to build a lasting career within it. Organized by the <strong>Field Trips and Seminars Technical Working Group</strong> consisting of 60 members, the activity brings together experienced industry practitioners to deliver talks across three focus areas.</p>
						<ol class="about-focus">
							{focusAreas.map((title) => <li>{title}</li>)}
						</ol>
					</div>
				</div>
			</section>

			<section id="agenda" class="agenda-section">
				<div class="section-container">
					<div class="agenda-intro">
						<div>
							<h2>Program of activities</h2>
							<p>A full day of talks with Q&A, a live mock interview, lightning talks, and raffles, from registration at {dayStart} to closing at {dayEnd}.</p>
						</div>
						<dl class="agenda-facts">
							<div><dt>Registration</dt><dd>{dayStart}</dd></div>
							<div><dt>Program starts</dt><dd>{programStart}</dd></div>
							{lunch && <div><dt>Lunch</dt><dd>{to12Hour(lunch.start)} to {to12Hour(lunch.end)}</dd></div>}
							<div><dt>Talks</dt><dd>{talkCount}, with Q&A</dd></div>
						</dl>
					</div>

					<table class="agenda-table">
						<caption class="sr-only">Program of activities, {dayStart} to {dayEnd}</caption>
						<thead>
							<tr>
								<th scope="col">Time</th>
								<th scope="col">Activity</th>
								<th scope="col">Details</th>
								<th scope="col">Person / Group Responsible</th>
							</tr>
						</thead>
						<tbody>
							{schedule.map(({ startLabel, endLabel, duration, title, details, by, kind, note }) => (
								<tr class:list={['agenda-row', kind]}>
									<td class="agenda-time">
										<time>{startLabel}</time>
										<span>to {endLabel} · {duration}</span>
									</td>
									{kind === 'break' ? (
										<th scope="row" colspan="2" class="agenda-activity">{title}</th>
									) : (
										<>
											<th scope="row" class="agenda-activity">
												{title}
												{note && <span class="agenda-note">{note}</span>}
											</th>
											<td class="agenda-details">{details}</td>
										</>
									)}
									<td class:list={['agenda-by', { tba: !by }]}>{by ?? 'To be announced'}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<KeynoteSpeakers />

			<section id="faq" class="faq-section">
				<div class="section-container">
					<div class="faq">
						<div class="section-intro">
							<h2>FAQ</h2>
							<p>Still have questions? Reach out to the student coordinators and we will help.</p>
						</div>
						<div class="faq-list">
							{faqs.map(({ q, a }) => (
								<details><summary>{q}</summary><p>{a}</p></details>
							))}
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			import anime from 'animejs';

			// Respect accessibility preference
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!prefersReducedMotion) {
				// 1. Subtle, Professional Hero Entrance
				const heroTl = anime.timeline({
					easing: 'easeOutCubic',
				});

				heroTl
					.add({
						targets: '.hero-kicker',
						opacity: [0, 1],
						translateY: [-6, 0],
						duration: 400,
					})
					.add({
						targets: '.hero-copy h1',
						opacity: [0, 1],
						translateY: [14, 0],
						duration: 500,
					}, '-=250')
					.add({
						targets: '.hero-copy .intro',
						opacity: [0, 1],
						translateY: [10, 0],
						duration: 450,
					}, '-=350')
					.add({
						targets: '.hero-actions .button',
						opacity: [0, 1],
						translateY: [8, 0],
						delay: anime.stagger(60),
						duration: 400,
					}, '-=300')
					.add({
						targets: '.hero-card',
						opacity: [0, 1],
						translateY: [14, 0],
						duration: 550,
					}, '-=400');

				// 2. Discrete Scroll Reveal via IntersectionObserver
				const observeAndAnimate = (selector: string, callback: (el: HTMLElement) => void, threshold = 0.12) => {
					const elements = document.querySelectorAll<HTMLElement>(selector);
					if (!elements.length) return;

					const observer = new IntersectionObserver((entries, obs) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								callback(entry.target as HTMLElement);
								obs.unobserve(entry.target);
							}
						});
					}, { threshold });

					elements.forEach((el) => observer.observe(el));
				};

				// About Section
				observeAndAnimate('#programs', (section) => {
					anime({
						targets: section.querySelectorAll('.about-kicker, h2, .about-tagline, .about-body'),
						opacity: [0, 1],
						translateY: [12, 0],
						delay: anime.stagger(60),
						duration: 450,
						easing: 'easeOutCubic',
					});

					anime({
						targets: section.querySelectorAll('.about-focus li'),
						opacity: [0, 1],
						translateY: [8, 0],
						delay: anime.stagger(50),
						duration: 400,
						easing: 'easeOutCubic',
					});
				});

				// Agenda Section
				observeAndAnimate('#agenda', (section) => {
					anime({
						targets: section.querySelectorAll('.agenda-intro, .agenda-facts div'),
						opacity: [0, 1],
						translateY: [12, 0],
						delay: anime.stagger(50),
						duration: 450,
						easing: 'easeOutCubic',
					});

					anime({
						targets: section.querySelectorAll('.agenda-table tbody tr'),
						opacity: [0, 1],
						translateY: [6, 0],
						delay: anime.stagger(20),
						duration: 350,
						easing: 'easeOutCubic',
					});
				});

				// Keynote Speakers
				observeAndAnimate('#speakers', (section) => {
					anime({
						targets: section.querySelectorAll('.section-intro'),
						opacity: [0, 1],
						translateY: [12, 0],
						duration: 450,
						easing: 'easeOutCubic',
					});

					anime({
						targets: section.querySelectorAll('.speaker-card'),
						opacity: [0, 1],
						translateY: [14, 0],
						delay: anime.stagger(80),
						duration: 450,
						easing: 'easeOutCubic',
					});
				});

				// FAQ Section
				observeAndAnimate('#faq', (section) => {
					anime({
						targets: section.querySelectorAll('.section-intro, .faq-list details'),
						opacity: [0, 1],
						translateY: [10, 0],
						delay: anime.stagger(40),
						duration: 400,
						easing: 'easeOutCubic',
					});
				});
			}
		</script>
	</body>
</html>
