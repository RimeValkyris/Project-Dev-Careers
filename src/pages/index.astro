---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import KeynoteSpeakers from '../components/KeynoteSpeakers.astro';
import { getImage } from 'astro:assets';
import HeroSource from '../assets/94IMGBG.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const HeroImage = await getImage({ src: HeroSource, width: 2400, format: 'webp', quality: 80 });

const features = [
	{ title: 'Professional development', text: 'Access seminars and workshops that turn broad advice into a next step you can actually take.' },
	{ title: 'Peer networking', text: 'Meet learners, mentors, and builders who can share context, feedback, and opportunity.' },
	{ title: 'Practical leadership', text: 'Practice communication, collaboration, and ownership through small projects and group work.' },
];

const pathways = [
	{ tag: 'Learners', title: 'Starting out', text: 'Build foundations, find a direction, and make your first useful projects visible.', cta: 'Join a session', href: '#event' },
	{ tag: 'Builders', title: 'Moving forward', text: 'Sharpen your craft, share your experience, and connect with the next opportunity.', cta: 'See the program', href: '#programs', featured: true },
	{ tag: 'Mentors', title: 'Giving back', text: 'Help someone one step behind you with context, encouragement, and practical feedback.', cta: 'Get involved', href: '#contact' },
];

const steps = [
	{ title: 'Show up', text: 'Choose a seminar, bring your questions, and start where you are.' },
	{ title: 'Work through it', text: 'Use the workshop to turn ideas into a small, concrete piece of work.' },
	{ title: 'Keep building', text: 'Leave with a 30-day plan and a community to return to.' },
];

const agenda = [
	{ time: '10:00', title: 'Find your starting point', text: 'Separate signal from noise and identify the work that energizes you.' },
	{ time: '10:35', title: 'Make your work visible', text: 'Shape small projects into a portfolio that tells a credible story.' },
	{ time: '11:10', title: 'Workshop: your next 30 days', text: 'Leave with a focused plan and time to ask practical questions.' },
];

const faqs = [
	{ q: 'Who is Dev Pipeline 2026 for?', a: 'Anyone exploring software development, from first-time learners to working developers who want to keep growing.' },
	{ q: 'Do I need professional experience?', a: 'No. Sessions are designed to meet you at your current level and give you a useful next step.' },
	{ q: 'What should I bring?', a: 'Bring your questions, your current project if you have one, and a willingness to try something small.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content" class="home-main">
			<section class="portal-hero" style={`--hero-image: url(${HeroImage.src})`}>
				<div class="hero-copy">
					<p class="eyebrow">Presented By TWG Committee</p>
					<h1>BEYOND<br /><span>THE SOARING CAPS</span></h1>
					<p class="intro">Dev Pipeline connects curious learners, working developers, and mentors through practical seminars, honest conversations, and shared momentum.</p>
					<div class="hero-actions">
						<a class="button primary" href="#programs">Explore the program</a>
						<a class="button ghost" href="#event">See upcoming event <span aria-hidden="true">→</span></a>
					</div>
				</div>
				<aside class="hero-panel" aria-label="Next seminar">
					<div class="hero-panel-top">
						<span class="pill">Seminar 01</span>
						<span class="panel-mark" aria-hidden="true">DP</span>
					</div>
					<strong>From first commit to next opportunity.</strong>
					<dl class="panel-meta">
						<div><dt>When</dt><dd>Friday · 10:00 AM</dd></div>
						<div><dt>Format</dt><dd>Talk + guided workshop</dd></div>
					</dl>
					<a class="panel-link" href="#agenda">View the agenda <span aria-hidden="true">→</span></a>
				</aside>
			</section>

			<section id="programs" class="section-block">
				<div class="section-intro">
					<p class="eyebrow">Why Dev Pipeline</p>
					<h2>A community built for professional growth.</h2>
					<p>Clear guidance, useful practice, and people who understand that every career starts somewhere.</p>
				</div>
				<div class="card-grid">
					{features.map(({ title, text }, i) => (
						<article class="card">
							<span class="card-index">{String(i + 1).padStart(2, '0')}</span>
							<h3>{title}</h3>
							<p>{text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="pathways section-band">
				<div class="section-intro">
					<p class="eyebrow">Find your place</p>
					<h2>Choose your pathway.</h2>
					<p>Start with the kind of support you need right now. There is room to grow into the next one.</p>
				</div>
				<div class="card-grid">
					{pathways.map(({ tag, title, text, cta, href, featured }) => (
						<article class:list={['card', 'pathway-card', { featured }]}>
							<span class="pill">{tag}</span>
							<h3>{title}</h3>
							<p>{text}</p>
							<a class="text-link" href={href}>{cta} <span aria-hidden="true">→</span></a>
						</article>
					))}
				</div>
			</section>

			<section class="process section-block">
				<div class="section-intro">
					<p class="eyebrow">How it works</p>
					<h2>Your path to progress.</h2>
					<p>Three steps, one session, and a plan you can keep working on afterwards.</p>
				</div>
				<ol class="process-list">
					{steps.map(({ title, text }) => (
						<li><h3>{title}</h3><p>{text}</p></li>
					))}
				</ol>
			</section>

			<section id="event" class="event-section">
				<div>
					<p class="eyebrow">Upcoming seminar</p>
					<h2>Build your path into tech.</h2>
					<p>A practical session on turning curiosity into a sustainable software development career.</p>
					<div class="hero-actions">
						<a class="button light" href="#agenda">View session details</a>
						<a class="button ghost" href="#contact">Reserve a seat</a>
					</div>
				</div>
				<dl class="event-meta">
					<div><dt>When</dt><dd>Friday · 10:00 AM</dd></div>
					<div><dt>Format</dt><dd>Talk + guided workshop</dd></div>
					<div><dt>For</dt><dd>Students and career changers</dd></div>
				</dl>
			</section>

			<section id="agenda" class="agenda section-band">
				<div class="section-intro">
					<p class="eyebrow">The session</p>
					<h2>Agenda</h2>
				</div>
				<ol class="agenda-list">
					{agenda.map(({ time, title, text }) => (
						<li class="agenda-row">
							<time>{time}</time>
							<div><h3>{title}</h3><p>{text}</p></div>
						</li>
					))}
				</ol>
			</section>

			<KeynoteSpeakers />

			<section id="faq" class="faq section-block">
				<div class="section-intro">
					<p class="eyebrow">FAQ</p>
					<h2>Questions, answered.</h2>
					<p>Still unsure? <a href="#contact">Reach out to the team</a> and we will help.</p>
				</div>
				<div class="faq-list">
					{faqs.map(({ q, a }) => (
						<details><summary>{q}</summary><p>{a}</p></details>
					))}
				</div>
			</section>

			<section id="contact" class="closing">
				<p class="eyebrow">Dev Pipeline</p>
				<h2>Build what comes next.</h2>
				<p>Join the community, save your seat for the next seminar, or ask us anything.</p>
				<div class="hero-actions">
					<a class="button light" href="mailto:hello@devpipeline.example">Contact the team</a>
					<a class="button ghost" href="#event">See upcoming event</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
