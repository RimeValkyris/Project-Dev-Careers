---
import { SITE_TITLE } from '../consts';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/#programs', label: 'Programs' },
	{ href: '/#event', label: 'Events' },
	{ href: '/#speakers', label: 'Speakers' },
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/').replace(/\/+/g, '/');
const section = pathname.match(/[^\/]+/)?.[0];
const isActive = (href: string) => !href.includes('#') && (href === '/' ? pathname === '/' : section === href.slice(1));
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-header>
	<nav aria-label="Primary">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-mark" aria-hidden="true">DP</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>

		<ul class="nav-links" id="primary-menu" data-menu>
			{links.map(({ href, label }) => (
				<li>
					<a href={href} class:list={{ active: isActive(href) }} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
				</li>
			))}
			<li class="menu-cta">
				<a class="nav-cta" href="/#contact">Join the community <span aria-hidden="true">→</span></a>
			</li>
		</ul>

		<a class="nav-cta desktop-cta" href="/#contact">Join the community <span aria-hidden="true">→</span></a>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-menu" data-menu-toggle>
			<span class="sr-only">Open menu</span>
			<span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
		</button>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');

	if (header && toggle && menu) {
		const label = toggle.querySelector('.sr-only');
		const setOpen = (open: boolean) => {
			header.classList.toggle('menu-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			if (label) label.textContent = open ? 'Close menu' : 'Open menu';
		};

		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && header.classList.contains('menu-open')) {
				setOpen(false);
				toggle.focus();
			}
		});
		document.addEventListener('click', (event) => {
			if (!header.contains(event.target as Node)) setOpen(false);
		});

		const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style>
	.skip-link {
		background: var(--deep-blue);
		border-radius: 999px;
		color: white;
		font-weight: 700;
		left: 1rem;
		padding: 0.6rem 1rem;
		position: fixed;
		text-decoration: none;
		top: -4rem;
		transition: top 0.2s ease;
		z-index: 30;
	}
	.skip-link:focus { top: 1rem; }

	.site-header {
		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: saturate(160%) blur(14px);
		-webkit-backdrop-filter: saturate(160%) blur(14px);
		border: 1px solid rgba(255, 255, 255, 0.6);
		border-radius: 999px;
		box-shadow: 0 10px 30px rgba(11, 35, 66, 0.14);
		box-sizing: border-box;
		left: 50%;
		position: fixed;
		top: 1rem;
		transform: translateX(-50%);
		transition: background 0.25s ease, box-shadow 0.25s ease, top 0.25s ease, border-color 0.25s ease;
		width: min(1080px, calc(100% - 2rem));
		z-index: 20;
	}
	.site-header.is-scrolled {
		background: rgba(255, 255, 255, 0.95);
		border-color: var(--line);
		box-shadow: 0 8px 24px rgba(11, 35, 66, 0.12), 0 1px 0 rgba(11, 35, 66, 0.04);
		top: 0.6rem;
	}

	nav {
		align-items: center;
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		min-height: 3.5rem;
		padding: 0 0.5rem 0 0.6rem;
	}

	.brand {
		align-items: center;
		border-radius: 999px;
		color: var(--ink);
		display: flex;
		font-size: 1.05rem;
		font-weight: 700;
		gap: 0.6rem;
		letter-spacing: -0.01em;
		padding: 0.25rem 0.5rem 0.25rem 0.25rem;
		text-decoration: none;
	}
	.brand-mark {
		align-items: center;
		background: linear-gradient(135deg, var(--bold-blue), var(--deep-blue));
		border-radius: 50%;
		box-shadow: 0 4px 12px rgba(0, 37, 204, 0.35);
		color: white;
		display: inline-flex;
		font-size: 0.7rem;
		height: 2.2rem;
		justify-content: center;
		letter-spacing: 0.04em;
		transition: transform 0.25s ease;
		width: 2.2rem;
	}
	.brand:hover .brand-mark { transform: rotate(-8deg) scale(1.05); }

	.nav-links {
		align-items: center;
		background: rgba(0, 53, 122, 0.05);
		border-radius: 999px;
		display: flex;
		gap: 0.15rem;
		list-style: none;
		margin: 0;
		padding: 0.25rem;
	}
	.nav-links a {
		border-radius: 999px;
		color: var(--ink);
		display: block;
		font-size: 0.92rem;
		font-weight: 600;
		padding: 0.4rem 0.95rem;
		text-decoration: none;
		transition: background 0.2s ease, color 0.2s ease;
	}
	.nav-links a:hover { background: rgba(31, 72, 255, 0.1); color: var(--deep-blue); }
	.nav-links a.active {
		background: white;
		box-shadow: 0 1px 3px rgba(11, 35, 66, 0.12);
		color: var(--deep-blue);
	}
	.menu-cta { display: none; }

	.nav-cta {
		align-items: center;
		background: var(--deep-blue);
		border-radius: 999px;
		box-shadow: 0 6px 16px rgba(0, 37, 204, 0.28);
		color: white;
		display: inline-flex;
		font-size: 0.88rem;
		font-weight: 700;
		gap: 0.4rem;
		padding: 0.6rem 1.1rem;
		text-decoration: none;
		transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
		white-space: nowrap;
	}
	.nav-cta span { color: #b8ceff; transition: transform 0.2s ease; }
	.nav-cta:hover { background: var(--bold-blue); box-shadow: 0 8px 22px rgba(31, 72, 255, 0.38); transform: translateY(-1px); }
	.nav-cta:hover span { transform: translateX(3px); }

	a:focus-visible,
	button:focus-visible { outline: 2px solid var(--bold-blue); outline-offset: 2px; }

	.menu-toggle {
		background: transparent;
		border: 0;
		border-radius: 50%;
		cursor: pointer;
		display: none;
		height: 2.6rem;
		padding: 0;
		width: 2.6rem;
	}
	.menu-toggle:hover { background: rgba(31, 72, 255, 0.1); }
	.menu-icon { display: grid; gap: 4px; margin: auto; width: 18px; }
	.menu-icon span {
		background: var(--ink);
		border-radius: 2px;
		display: block;
		height: 2px;
		transition: transform 0.25s ease, opacity 0.2s ease;
	}
	.menu-open .menu-icon span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
	.menu-open .menu-icon span:nth-child(2) { opacity: 0; }
	.menu-open .menu-icon span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

	@media (max-width: 820px) {
		.site-header { border-radius: 1.75rem; }
		.site-header.menu-open { background: rgba(255, 255, 255, 0.98); }
		nav { flex-wrap: wrap; gap: 0; }
		.desktop-cta { display: none; }
		.menu-toggle { display: block; }
		.nav-links {
			background: none;
			display: none;
			flex-basis: 100%;
			flex-direction: column;
			align-items: stretch;
			gap: 0.2rem;
			padding: 0.25rem 0 0.75rem;
		}
		.menu-open .nav-links { display: flex; }
		.nav-links a { font-size: 1rem; padding: 0.75rem 1rem; }
		.nav-links a.active { background: rgba(31, 72, 255, 0.08); box-shadow: none; }
		.menu-cta { display: block; margin-top: 0.4rem; }
		.nav-links .nav-cta { color: white; justify-content: center; padding: 0.85rem 1rem; }
		.nav-links .nav-cta:hover { background: var(--bold-blue); color: white; }
	}

	@media (prefers-reduced-motion: reduce) {
		*, .skip-link { transition: none !important; }
	}
</style>
