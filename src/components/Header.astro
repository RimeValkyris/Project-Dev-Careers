---
import { SITE_TITLE } from '../consts';

// Split a trailing year (e.g. "2026") off the title so it can be styled separately.
const [, brandName, brandYear] = SITE_TITLE.match(/^(.*?)(?:\s+(\d{4}))?$/) ?? [, SITE_TITLE, undefined];

const links = [
	{ href: '/#programs', label: 'About' },
	{ href: '/#event', label: 'Seminar' },
	{ href: '/#agenda', label: 'Agenda' },
	{ href: '/#speakers', label: 'Speakers' },
	{ href: '/#faq', label: 'FAQ' },
];
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-header>
	<nav aria-label="Primary">
		<a class="brand" href="/">{brandName}{brandYear && <span class="brand-year"> {brandYear}</span>}</a>

		<ul class="nav-links" id="primary-menu" data-menu>
			{links.map(({ href, label }) => (
				<li><a href={href} data-section={href.split('#')[1]}>{label}</a></li>
			))}
			<li class="menu-cta"><a class="nav-cta" href="/#contact">Reserve a seat</a></li>
		</ul>

		<a class="nav-cta desktop-cta" href="/#contact">Reserve a seat</a>

		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-menu" data-menu-toggle>
			<span class="menu-label">Menu</span>
			<span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
		</button>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-header]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-menu]');

	if (header && toggle && menu) {
		const label = toggle.querySelector('.menu-label');
		const setOpen = (open: boolean) => {
			header.classList.toggle('menu-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			if (label) label.textContent = open ? 'Close' : 'Menu';
		};

		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && header.classList.contains('menu-open')) {
				setOpen(false);
				toggle.focus();
			}
		});
		document.addEventListener('click', (event) => {
			if (!header.contains(event.target as Node)) setOpen(false);
		});

		// Solid bar once the page scrolls past the top of the banner.
		const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		// Underline the link for the section currently in view.
		const navLinks = [...menu.querySelectorAll<HTMLAnchorElement>('a[data-section]')];
		const sections = navLinks
			.map((link) => document.getElementById(link.dataset.section ?? ''))
			.filter((section): section is HTMLElement => section !== null);

		const setCurrent = (id: string | null) => {
			for (const link of navLinks) {
				const current = link.dataset.section === id;
				link.classList.toggle('current', current);
				if (current) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			}
		};

		const visible = new Map<string, number>();
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
				const [id, ratio] = [...visible.entries()].sort((a, b) => b[1] - a[1])[0] ?? [null, 0];
				setCurrent(ratio > 0 ? id : null);
			},
			{ rootMargin: '-35% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
		);
		sections.forEach((section) => observer.observe(section));
	}
</script>

<style>
	.skip-link {
		background: var(--ink);
		border-radius: 8px;
		color: white;
		font-weight: 700;
		left: 1rem;
		padding: 0.6rem 1rem;
		position: fixed;
		text-decoration: none;
		top: -4rem;
		transition: top 0.2s ease;
		z-index: 30;
	}
	.skip-link:focus { top: 1rem; }

	.site-header {
		--nav-fg: white;
		--nav-muted: rgba(255, 255, 255, 0.78);
		--nav-mark: #8fb0ff;
		background: transparent;
		border-bottom: 2px solid transparent;
		left: 0;
		position: fixed;
		right: 0;
		top: 0;
		transition: background 0.25s ease, border-color 0.25s ease;
		z-index: 20;
	}
	.site-header.is-scrolled,
	.site-header.menu-open {
		--nav-fg: var(--ink);
		--nav-muted: var(--muted);
		--nav-mark: var(--bold-blue);
		background: var(--texture), var(--paper);
		border-bottom-color: var(--ink);
	}

	nav {
		align-items: center;
		box-sizing: border-box;
		display: flex;
		gap: 2rem;
		margin: 0 auto;
		max-width: calc(1080px + 2rem);
		min-height: 4.5rem;
		padding: 0 1rem;
	}

	.brand {
		color: var(--nav-fg);
		font-family: var(--font-display), sans-serif;
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		margin-right: auto;
		text-decoration: none;
		transition: color 0.25s ease;
	}

	.brand-year { color: var(--nav-mark); transition: color 0.25s ease; }

	.nav-links {
		align-items: center;
		display: flex;
		gap: 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.nav-links a {
		color: var(--nav-muted);
		display: block;
		font-size: 0.95rem;
		font-weight: 700;
		padding: 0.35rem 0;
		position: relative;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.nav-links a::after {
		background: var(--nav-mark);
		bottom: -2px;
		content: '';
		height: 3px;
		left: 0;
		position: absolute;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.2s ease;
		width: 100%;
	}
	.nav-links a:hover,
	.nav-links a.current { color: var(--nav-fg); }
	.nav-links a:hover::after,
	.nav-links a.current::after { transform: scaleX(1); }
	.menu-cta { display: none; }

	.nav-cta {
		background: var(--bold-blue);
		border-radius: 10px;
		box-shadow: 0 3px 0 #0019a3;
		color: white;
		font-size: 0.9rem;
		font-weight: 700;
		padding: 0.6rem 1.1rem;
		text-decoration: none;
		transition: box-shadow 0.15s ease, transform 0.15s ease;
		white-space: nowrap;
	}
	.nav-cta:hover { box-shadow: 0 5px 0 #0019a3; color: white; transform: translateY(-2px); }
	.nav-cta:active { box-shadow: 0 1px 0 #0019a3; transform: translateY(2px); }

	a:focus-visible,
	button:focus-visible { outline: 2px solid var(--nav-mark); outline-offset: 4px; }

	.menu-toggle {
		align-items: center;
		background: none;
		border: 2px solid var(--nav-fg);
		border-radius: 10px;
		color: var(--nav-fg);
		cursor: pointer;
		display: none;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 700;
		gap: 0.6rem;
		padding: 0.45rem 0.8rem;
	}
	.menu-icon { display: grid; gap: 5px; width: 16px; }
	.menu-icon span { background: currentColor; border-radius: 2px; display: block; height: 2px; transition: transform 0.2s ease; }
	.menu-open .menu-icon span:first-child { transform: translateY(3.5px) rotate(45deg); }
	.menu-open .menu-icon span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

	@media (max-width: 860px) {
		nav { flex-wrap: wrap; gap: 0; min-height: 4rem; }
		.desktop-cta { display: none; }
		.menu-toggle { display: inline-flex; }
		.nav-links {
			align-items: stretch;
			border-top: 1px solid var(--line);
			display: none;
			flex-basis: 100%;
			flex-direction: column;
			gap: 0;
			margin: 0 -1rem;
			order: 3;
			padding: 0.5rem 1rem 1.25rem;
		}
		.menu-open .nav-links { display: flex; }
		.nav-links li { border-bottom: 1px solid var(--line); }
		.nav-links a {
			color: var(--ink);
			font-family: var(--font-display), sans-serif;
			font-size: 1.5rem;
			font-weight: 800;
			padding: 0.8rem 0;
		}
		.nav-links a::after { display: none; }
		.nav-links a.current { color: var(--bold-blue); }
		.menu-cta { border-bottom: 0 !important; display: block; margin-top: 1rem; }
		.nav-links .nav-cta { color: white; display: block; font-family: inherit; font-size: 1rem; padding: 0.9rem 1rem; text-align: center; }
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header, .brand, .nav-links a, .nav-links a::after, .nav-cta, .menu-icon span, .skip-link { transition: none; }
		.nav-cta:hover, .nav-cta:active { transform: none; }
	}
</style>
