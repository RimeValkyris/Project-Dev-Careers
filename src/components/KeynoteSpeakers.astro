---
type Speaker = {
	name: string;
	role: string;
	organization: string;
	talk: string;
	bio: string;
	photo?: string;
	link?: string;
};

const speakers: Speaker[] = [
	{
		name: 'John Sebastian Mangilin',
		role: 'TODO: Confirm role',
		organization: 'TODO: Confirm organization',
		talk: 'Emerging Technologies',
		bio: 'A BS Information Technology graduate of Nueva Ecija University of Science and Technology (NEUST). As an IT professional and UI/UX graphic designer specializing in web systems, he has strengthened his design knowledge and skills through continued practice and project experience.',
	},
	{
		name: 'Neil Ryan V. Lumacad',
		role: 'President',
		organization: 'Philippines HR Group',
		talk: 'Employability Tips and Jobs',
		bio: 'A Certified Human Resource Professional and Certified Learning and Development Professional with more than 20 years of experience in talent management, organizational development, learning and development, and employee engagement.',
		photo: '/speakers/neil-lumacad.png',
	},
	{
		name: 'Tina Khoe Ang',
		role: 'Business Leader and HR Practitioner',
		organization: 'Rita’s Italian Ice Philippines',
		talk: 'Resume & Portfolio, and How to Market Yourself',
		bio: 'A business leader, HR practitioner, and advocate who helps employers and employees navigate workplace challenges. She is also a columnist for The Manila Times and an active co-moderator of major Philippine HR communities.',
		photo: '/speakers/tina-khoe-ang.png',
	},
];

// Only http(s) links are rendered, so a bad value can't become a javascript: URL.
const safeLink = (url?: string) => {
	if (!url) return undefined;
	try {
		const parsed = new URL(url);
		return parsed.protocol === 'https:' || parsed.protocol === 'http:' ? parsed.href : undefined;
	} catch {
		return undefined;
	}
};

const initials = (name: string) =>
	name
		.split(/\s+/)
		.map((part) => part[0])
		.join('')
		.slice(0, 2)
		.toUpperCase();
---

<section id="speakers" class="speakers-section" aria-labelledby="speakers-heading">
	<div class="section-container">
		<div class="section-intro">
			<h2 id="speakers-heading">Keynote speakers</h2>
			<p>HR, business, and technology practitioners share practical advice for preparing for work after graduation.</p>
		</div>

		<ul class="speaker-grid">
			{speakers.map((speaker) => (
				<li class="speaker-card">
					<div class="speaker-photo">
						{speaker.photo ? (
							<img src={speaker.photo} alt={`${speaker.name} portrait`} />
						) : (
							<span class="speaker-initials" aria-hidden="true">{initials(speaker.name)}</span>
						)}
					</div>
					<div class="speaker-body">
						<h3>{safeLink(speaker.link) ? <a href={safeLink(speaker.link)} target="_blank" rel="noopener noreferrer">{speaker.name}</a> : speaker.name}</h3>
						<p class="speaker-role">{speaker.role}, {speaker.organization}</p>
						<p class="speaker-talk"><span class="talk-label">Talk</span> {speaker.talk}</p>
						<p class="speaker-bio">{speaker.bio}</p>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.speakers-section {
		padding: 5.5rem 0;
		background: var(--bg-main);
		border-bottom: 1px solid var(--line);
	}
	.section-intro { margin-bottom: 2.25rem; }
	.section-intro h2 { font-size: clamp(1.75rem, 3.2vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
	.section-intro p { color: var(--muted); font-size: 0.95rem; margin: 0.65rem 0 0; }

	.speaker-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.speaker-card {
		background: var(--bg-card);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.speaker-card:hover {
		border-color: var(--blue-border);
		transform: translateY(-2px);
	}
	.speaker-photo {
		align-items: center;
		aspect-ratio: 4 / 3;
		background: #060b17;
		border-bottom: 1px solid var(--line);
		display: flex;
		justify-content: center;
		overflow: hidden;
		position: relative;
	}
	.speaker-photo img {
		height: 100%;
		object-fit: cover;
		width: 100%;
	}
	.speaker-initials {
		align-items: center;
		background: #0d172e;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--blue-light);
		display: flex;
		font-size: 1.5rem;
		font-weight: 700;
		height: 4.5rem;
		justify-content: center;
		letter-spacing: 0.04em;
		width: 4.5rem;
	}
	.speaker-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.35rem;
		gap: 0.25rem;
	}
	.speaker-body h3 {
		font-family: var(--font-display), sans-serif;
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		margin: 0;
		color: var(--ink);
	}
	.speaker-body h3 a { color: inherit; text-decoration: none; }
	.speaker-body h3 a:hover { color: var(--blue-light); }
	.speaker-role {
		color: #93c5fd;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		margin: 0.25rem 0 0.65rem;
	}
	.talk-label {
		color: var(--muted);
		display: block;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		margin-bottom: 0.2rem;
		text-transform: uppercase;
	}
	.speaker-talk {
		color: var(--ink);
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.4;
		margin: 0 0 0.65rem;
	}
	.speaker-bio {
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.55;
		margin: 0;
	}

	@media (max-width: 900px) {
		.speaker-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 560px) {
		.speaker-grid { grid-template-columns: 1fr; }
	}
</style>
