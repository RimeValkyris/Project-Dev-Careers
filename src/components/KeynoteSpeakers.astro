---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SpeakerPhoto1 from '../assets/TestImg1.webp';
import SpeakerPhoto2 from '../assets/TestImg2.jpg';
import SpeakerPhoto3 from '../assets/TestImg3.png';
import SpeakerPhoto4 from '../assets/TestImg4.jpg';

type Speaker = {
	name: string;
	role: string;
	organization: string;
	talk: string;
	bio: string;
	photo?: ImageMetadata;
	link?: string;
};

// Replace these placeholders with the confirmed keynote speakers.
// To add a photo, import it from src/assets and set `photo`.
const speakers: Speaker[] = [
	{
		name: 'Viktor Tsoi',
		role: 'Senior Software Engineer',
		organization: 'Company Name',
		talk: 'From first commit to first offer',
		bio: 'Shares how small, visible projects turned into real interviews, and what hiring teams actually look for.',
		photo: SpeakerPhoto1,
	},
	{
		name: 'Sylvie Dubois',
		role: 'Engineering Manager',
		organization: 'Company Name',
		talk: 'What makes a junior developer stand out',
		bio: 'Walks through the habits, questions, and communication that make new developers easy to trust and grow.',
		photo: SpeakerPhoto2,
	},
	{
		name: 'Anastasya Feodorovna Snezhnaya',
		role: 'Community Lead',
		organization: 'Organization Name',
		talk: 'Building a career in public',
		bio: 'Explains how communities, mentors, and consistent sharing open doors that applications alone do not.',
		photo: SpeakerPhoto3,
	},
	{
		name: 'Lao Shan Lung',
		role: 'Community Lead',
		organization: 'Organization Name',
		talk: 'Building a career in public',
		bio: 'Explains how communities, mentors, and consistent sharing open doors that applications alone do not.',
		photo: SpeakerPhoto4,
	},
];

// Only http(s) links are rendered, so a bad value can't become a javascript: URL.
const safeLink = (url?: string) => {
	if (!url) return undefined;
	try {
		const parsed = new URL(url);
		return parsed.protocol === 'https:' || parsed.protocol === 'http:' ? parsed.href : undefined;
	} catch {
		return undefined;
	}
};

const initials = (name: string) =>
	name
		.split(/\s+/)
		.map((part) => part[0])
		.join('')
		.slice(0, 2)
		.toUpperCase();
---

<section id="speakers" class="speakers section-block" aria-labelledby="speakers-heading">
	<div class="section-intro">
		<h2 id="speakers-heading">Keynote speakers</h2>
		<p>Practitioners who have made the move into tech share what worked, what didn't, and what they would do again.</p>
	</div>

	<ul class="speaker-grid">
		{speakers.map((speaker) => (
			<li class="speaker-card">
				<div class="speaker-photo">
					{speaker.photo ? (
						<Image src={speaker.photo} alt={`Portrait of ${speaker.name}`} width={720} format="webp" quality={80} loading="lazy" />
					) : (
						<span class="speaker-initials" aria-hidden="true">{initials(speaker.name)}</span>
					)}
				</div>
				<div class="speaker-body">
					<h3>{safeLink(speaker.link) ? <a href={safeLink(speaker.link)} target="_blank" rel="noopener noreferrer">{speaker.name}</a> : speaker.name}</h3>
					<p class="speaker-role">{speaker.role}, {speaker.organization}</p>
					<p class="speaker-talk"><span class="talk-label">Talk</span> {speaker.talk}</p>
					<p class="speaker-bio">{speaker.bio}</p>
				</div>
			</li>
		))}
	</ul>
</section>

<style>
	.speakers {
		margin-left: 50%;
		transform: translateX(-50%);
		width: min(1400px, calc(100vw - 2em));
	}
	.speaker-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.speaker-card {
		background: white;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}
	.speaker-card { transform: rotate(-1.2deg); }
	.speaker-card:nth-child(even) { transform: rotate(1.2deg); }
	.speaker-photo { margin: 0.6rem 0.6rem 0; border-radius: 10px; }
	.speaker-body h3 { font-family: var(--font-display), sans-serif; }
	.speaker-photo {
		align-items: center;
		aspect-ratio: 4 / 3;
		background:
			radial-gradient(circle at 75% 20%, rgba(184, 206, 255, 0.35), transparent 45%),
			linear-gradient(135deg, var(--sea-blue), var(--deep-blue));
		display: flex;
		justify-content: center;
		overflow: hidden;
		position: relative;
	}
	.speaker-photo img {
		border-radius: 0;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		width: 100%;
	}
	.speaker-initials {
		align-items: center;
		border: 1px solid rgba(255, 255, 255, 0.55);
		border-radius: 50%;
		color: white;
		display: flex;
		font-size: 1.6rem;
		font-weight: 700;
		height: 6rem;
		justify-content: center;
		letter-spacing: 0.04em;
		width: 6rem;
	}
	.speaker-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.5rem;
	}
	.talk-label {
		color: var(--muted);
		display: block;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.speaker-talk {
		color: var(--bold-blue);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.35;
		margin: 0 0 1.25rem;
	}
	.speaker-body h3 {
		font-size: 1.4rem;
		margin: 0;
	}
	.speaker-body h3 a {
		color: inherit;
		text-decoration: none;
	}
	.speaker-body h3 a:hover { color: var(--deep-blue); }
	.speaker-role {
		color: var(--cobalt-blue);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		margin: 0.35rem 0 1rem;
	}
	.speaker-bio {
		color: #52677f;
		font-size: 0.95rem;
		margin: 0;
	}

	@media (max-width: 900px) {
		.speaker-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 560px) {
		.speaker-grid { grid-template-columns: 1fr; }
	}
</style>
