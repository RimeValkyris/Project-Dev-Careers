---
import { SITE_TITLE } from '../consts';

// Split a trailing year (e.g. "2026") off the title so it can be styled separately.
const [, brandName, brandYear] = SITE_TITLE.match(/^(.*?)(?:\s+(\d{4}))?$/) ?? [, SITE_TITLE, undefined];

const today = new Date();

const links = [
	{ href: '/#programs', label: 'About' },
	{ href: '/#agenda', label: 'Agenda' },
	{ href: '/#speakers', label: 'Speakers' },
	{ href: '/#faq', label: 'FAQ' },
];
---

<footer>
	<div class="section-container">
		<div class="footer-inner">
			<div class="footer-brand">
				<a class="brand" href="/">
					{brandName}{brandYear && <span class="brand-year"> {brandYear}</span>}
				</a>
				<p>Practical seminars and a community for people building careers in software.</p>
			</div>
			<nav aria-label="Footer">
				<ul>
					{links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
				</ul>
			</nav>
		</div>
		<div class="footer-bottom">
			<span>&copy; {today.getFullYear()} {brandName}. College of Computer Studies.</span>
			<a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
		</div>
	</div>
</footer>
<style>
	footer {
		background: #060d1e;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		color: #94a3b8;
		font-size: 0.92rem;
		padding: 4.5rem 0 2.5rem;
	}
	.footer-inner {
		align-items: flex-start;
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		justify-content: space-between;
	}
	.footer-brand { max-width: 380px; }
	.footer-brand p { margin: 0.75rem 0 0; color: #64748b; line-height: 1.6; }
	.brand {
		align-items: center;
		color: white;
		display: inline-flex;
		font-family: var(--font-display), sans-serif;
		font-size: 1.25rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.brand-year { color: var(--blue-mid); }
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a { color: #94a3b8; text-decoration: none; transition: color 0.15s; }
	a:hover { color: white; }
	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		flex-wrap: wrap;
		font-size: 0.85rem;
		gap: 1rem;
		justify-content: space-between;
		margin-top: 3rem;
		padding-top: 1.75rem;
		color: #64748b;
	}
	.footer-bottom a { color: #64748b; }
	.footer-bottom a:hover { color: white; }
</style>
