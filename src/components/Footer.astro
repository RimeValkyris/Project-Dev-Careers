---
import { SITE_TITLE } from '../consts';

const today = new Date();

const links = [
	{ href: '/#programs', label: 'Programs' },
	{ href: '/#event', label: 'Events' },
	{ href: '/#speakers', label: 'Speakers' },
	{ href: '/#faq', label: 'FAQ' },
	{ href: '/#contact', label: 'Contact' },
];
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<a class="brand" href="/">
				{SITE_TITLE}
			</a>
			<p>Practical seminars and a community for people building careers in software.</p>
		</div>
		<nav aria-label="Footer">
			<ul>
				{links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
			</ul>
		</nav>
	</div>
	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} {SITE_TITLE}. Built for learning.</span>
		<a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.95rem;
		margin-top: 3rem;
		padding: 3.5rem max(1.5rem, calc(50vw - 540px)) 2rem;
	}
	.footer-inner {
		align-items: flex-start;
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		justify-content: space-between;
	}
	.footer-brand { max-width: 360px; }
	.footer-brand p { margin: 0.75rem 0 0; }
	.brand {
		align-items: center;
		color: var(--ink);
		display: inline-flex;
		font-family: var(--font-display), sans-serif;
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	a { color: var(--muted); text-decoration: none; }
	a:hover { color: var(--deep-blue); }
	.footer-bottom {
		border-top: 1px solid var(--line);
		display: flex;
		flex-wrap: wrap;
		font-size: 0.85rem;
		gap: 1rem;
		justify-content: space-between;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
	}
</style>
